# Cloudflare Web Analytics (cookielos, kein Consent nötig)
VITE_CF_BEACON_TOKEN=

# Google Analytics 4 — ohne Wert wird GA4 nie geladen
VITE_GA4_ID=G-00XYHZF3RD

# n8n-Webhook für Consent-Logging — leer lassen deaktiviert das Logging
VITE_CONSENT_WEBHOOK_URL=

# n8n-Webhooks für den BFSG-Schnelltest (Lighthouse-Scan)
# - SCAN: Startet den Scan, liefert sofort eine reportId zurück
# - STATUS: Polling während der Scan läuft (Teaser: Score + Zähler, KEINE Fehlerliste)
# - UNLOCK: E-Mail-Gate — verschickt den Voll-Report-Link per Mail
# - FULL: Vollständiger Report (nur über den per Mail zugestellten Token erreichbar)
VITE_SCAN_WEBHOOK_URL=
VITE_SCAN_STATUS_URL=
VITE_SCAN_UNLOCK_URL=
VITE_SCAN_FULL_URL=
