# Cloudflare Web Analytics (cookielos, kein Consent nötig)
VITE_CF_BEACON_TOKEN=

# Google Analytics 4 — ohne Wert wird GA4 nie geladen
VITE_GA4_ID=G-00XYHZF3RD

# n8n-Webhook für Consent-Logging — leer lassen deaktiviert das Logging
VITE_CONSENT_WEBHOOK_URL=

# n8n-Webhook für den BFSG-Schnelltest (Lighthouse-Scan) — leer lassen zeigt einen Konfigurationsfehler im Scanner
VITE_SCAN_WEBHOOK_URL=
